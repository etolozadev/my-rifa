# Variables para docker-compose.prod.yml (copiar a .env en el servidor; .env no se versiona)

# Base de datos
POSTGRES_USER=rifas
POSTGRES_DB=rifas
# Contraseña larga y aleatoria (openssl rand -hex 24)
POSTGRES_PASSWORD=

# Secreto de sesión: largo y aleatorio (openssl rand -hex 32)
JWT_SECRET=

# Dominio público del front (CORS y cookies)
WEB_ORIGIN=https://rifas.estebantoloza.cl
ALLOW_REGISTRATION=false

# Dónde publica el contenedor web. Por defecto solo en 127.0.0.1:8080 para que el proxy
# con HTTPS del VPS lo reenvíe; usa WEB_BIND=0.0.0.0 para exponerlo directo.
WEB_BIND=127.0.0.1
WEB_PORT=8080
