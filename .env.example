# Variables de docker-compose.prod.yml.
# En Coolify se ven en Configuration > Environment Variables: las SERVICE_* las genera Coolify y el resto se completa ahí.
# Este archivo sirve para probar el compose de producción fuera de Coolify:
#   docker compose -f docker-compose.prod.yml --env-file .env up --build

# Generadas por Coolify (fuera de Coolify: openssl rand -hex 16 / openssl rand -hex 32)
SERVICE_PASSWORD_POSTGRES=
SERVICE_HEX_64_JWT=

# URL pública del front (CORS, cookies y enlaces de los correos). Obligatoria.
WEB_ORIGIN=https://rifas.estebantoloza.cl
ALLOW_REGISTRATION=false

# Avisos por correo al equipo (comprobante nuevo, resultado del sorteo). Opcional.
# Gmail con contraseña de aplicación: smtps://tu.correo%40gmail.com:clavedeaplicacion@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Rifas <tu.correo@gmail.com>
