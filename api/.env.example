NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://rifas:rifas@localhost:5432/rifas_dev
# Cambiar por un secreto largo y aleatorio (openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Carpeta privada para comprobantes (fuera de cualquier carpeta pública)
UPLOADS_DIR=./storage/comprobantes
# Origen del front, para CORS con cookies (ej. https://rifas.estebantoloza.cl)
WEB_ORIGIN=http://localhost:5173
# En un uso personal se dejan las cuentas creadas por script: user:create
ALLOW_REGISTRATION=false
